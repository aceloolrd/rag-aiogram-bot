# Telegram
TELEGRAM_TOKEN=123456:ABCDEF

# OpenAI
OPENAI_API_KEY=sk-...
# Если используешь прокси/совместимый сервер — укажи base_url.
# Оставь пустым, если работаешь с обычным OpenAI.
OPENAI_BASE_URL=

# Модели
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# Опционально: канал для обязательной подписки (например -1001234567890 или @channelname)
REQUIRED_CHANNEL=

# Опционально: список админов через запятую
ADMINS=123456789,987654321

# Опционально: "рабочее время" бота (по локали сервера)
WORK_TIME_START=08:00
WORK_TIME_END=23:00
